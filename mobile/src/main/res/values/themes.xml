<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window colours behind Compose, so launch and system bars match direction B "paper" (light). -->
    <style name="Theme.Ronde" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F7F5F0</item>
        <item name="android:colorBackground">#F7F5F0</item>
        <item name="android:statusBarColor">#F7F5F0</item>
        <item name="android:navigationBarColor">#EFECE5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
