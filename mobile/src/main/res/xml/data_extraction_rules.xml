<?xml version="1.0" encoding="utf-8"?>
<!-- The encrypted credentials are bound to this device's Keystore key; never restore them elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
